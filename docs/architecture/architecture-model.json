{
  "schema_name": "geotile_architecture_model",
  "schema_version": 1,
  "_meta": {
    "purpose": "Jedno zrodlo TRESCI dla trzech konsumentow: rysunkow artykulu (Figma -> SVG), interaktywnego explorera i generowanych zrodel d2. Uklad NIE jest tu opisany - zostaje recznie w Figmie i w explorer.html.",
    "decisions": "DESIGN_DECISIONS.md, architecture-diagrams",
    "appears_in": "Kazdy element deklaruje, gdzie ma sie pojawic. Bramka porownuje kazdy artefakt TYLKO z tym, co dla niego oznaczone - dzieki temu odroznia zamierzone uproszczenie od przeoczenia.",
    "extra_fields": "Pola `attrs_explorer` / `items_explorer` / `parts_explorer` niosa tresc, ktora trafia WYLACZNIE do explorera. Rysunki artykulu uzywaja `attrs` / `items` / `parts`.",
    "language": "`title` jest angielski i podlega bramce w obu konsumentach. `summary_pl` uzywa wylacznie explorer. `summary_en` jest poza zakresem tej iteracji."
  },
  "stereotypes": {
    "canonical": "«canonical»",
    "derived": "«derived»",
    "export": "«export»",
    "source": "«source»"
  },
